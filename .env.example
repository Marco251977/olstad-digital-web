# The settings the website's server side (api/admin.js) needs – names only, never values. Set them in Vercel
# (Project → Settings → Environment Variables); a local .env.local is never committed.

# /admin sign-in (Supabase Auth in the Saldo Pocket project)
ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# /admin/plantravel statistics: PlanTravel's server and the secret key for GET /stats/summary (server side only)
PLANTRAVEL_API_URL=
PLANTRAVEL_STATS_KEY=
