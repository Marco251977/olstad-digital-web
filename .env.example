# The settings the website's server side (api/admin.js) needs – names only, never values. Set them in Vercel
# (Project → Settings → Environment Variables); a local .env.local is never committed.

# /admin sign-in: e-mail + password (the same for preview and production). Only the addresses in ADMIN_EMAILS get in.
# ADMIN_PASSWORD_HASH = the bcrypt hash of the password (the password itself is only in the keys folder, felles.env
# ADMIN_PASSWORD); ADMIN_SESSION_SECRET signs the 30-day session cookie (random, also in felles.env).
ADMIN_EMAILS=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# The fallback behind «Forgot password?»: an e-mail code from Supabase Auth in the Saldo Pocket project
SUPABASE_URL=
SUPABASE_ANON_KEY=

# /admin/plantravel statistics: PlanTravel's server and the secret key for GET /stats/summary (server side only)
PLANTRAVEL_API_URL=
PLANTRAVEL_STATS_KEY=
# /admin/plantravel «Til godkjenning»: the key for PlanTravel's /approval-queue/* (its own key, server side only)
PLANTRAVEL_ADMIN_QUEUE_KEY=

# /admin/saldo-pocket statistics: Saldo's Edge Function stats-summary (whole URL) and its key (server side only).
# The NOK conversion uses the exchange-rates function next to it with SUPABASE_ANON_KEY above (the Saldo project).
SALDO_STATS_URL=
SALDO_STATS_KEY=
